<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_top_rounded"
    android:backgroundTint="@color/card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Bara mică de sus pentru drag/vizual de Bottom Sheet -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Password"
        android:textColor="@color/navy_blue_1"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="Enter your email address and we will send you a secure link to reset your password."
        android:textColor="#999999"
        android:textSize="14sp" />

    <!-- Câmpul de text stilizat pentru Email -->
    <EditText
        android:id="@+id/edtResetEmail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_field"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:hint="Email address"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:textColor="@color/navy_blue_1"
        android:textSize="14sp" />

    <!-- Butonul de trimitere stilizat exact ca Log In-ul tău -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendResetLink"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Send Link"
        android:textColor="@color/cream"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/light_turq_1"
        app:cornerRadius="16dp" />

    <!-- Buton de cancel discret dedesubt -->
    <TextView
        android:id="@+id/txtCancelReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:text="Cancel"
        android:textColor="@color/navy_blue_1"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Buton de cancel încadrat într-un cadran gri deschis
    <com.google.android.material.button.MaterialButton
        android:id="@+id/txtCancelReset"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Cancel"
        android:textColor="@color/navy_blue_1"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#F2F2F2"
        app:cornerRadius="16dp"
        app:strokeWidth="0dp" -->
</LinearLayout>