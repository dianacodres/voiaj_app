<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:background="@drawable/interests_bg_card_frame"
    android:clickable="true"
    android:focusable="true"
    android:padding="3dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/interests_bg_image_placeholder"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:shapeAppearanceOverlay="@style/RoundedCorners" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/interests_bg_image_gradient" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:shadowColor="#80000000"
        android:shadowRadius="4"
        tools:text="Beaches" />

    <FrameLayout
        android:id="@+id/badgeBg"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/interests_bg_badge">

        <ImageView
            android:id="@+id/badgeIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/interests_ic_plus"
            android:contentDescription="@null" />
    </FrameLayout>

</FrameLayout>