<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/imgPoiFrame"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/imgPoiDisplay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/txtPoiDisplayName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textColor="@color/navy_blue_1"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imgPoiFrame"
        app:layout_constraintTop_toTopOf="@id/imgPoiFrame"
        app:layout_constraintEnd_toStartOf="@id/btnPoiLink" />

    <TextView
        android:id="@+id/txtPoiDisplaySubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#999999"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/txtPoiDisplayName"
        app:layout_constraintTop_toBottomOf="@id/txtPoiDisplayName"
        app:layout_constraintEnd_toStartOf="@id/btnPoiLink" />

    <!-- Iconita de link - "Buy tickets" (bilet) sau "More info" (i), in functie de PoiRow.isTicket -->
    <ImageView
        android:id="@+id/btnPoiLink"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="2dp"
        android:src="@drawable/ic_ticket"
        app:tint="@color/beige"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/imgPoiFrame"
        app:layout_constraintBottom_toBottomOf="@id/imgPoiFrame"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>