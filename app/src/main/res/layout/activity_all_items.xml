<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recommendedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btnBackAll"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_close_circle"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_forward"
            android:rotation="180"
            app:tint="@color/navy_blue_1"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/txtTitleAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="All Items"
            android:textColor="@color/navy_blue_1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAllItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/txtNoItemsAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="We couldn't find any items!"
            android:textColor="@color/navy_blue_2"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <!-- ── MUTAT AICI ÎN INTERIORUL FRAME-ULUI: Acum va pluti fix pe mijlocul ecranului ── -->
        <ProgressBar
            android:id="@+id/pbAllItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminate="true"
            android:indeterminateTint="#007AFF" />

    </FrameLayout>

</LinearLayout>