<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/exploreMapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".ExploreActivity">

    <!-- ── HEADER TRASEU COMPACT (Scris mare) ── -->
    <LinearLayout
        android:id="@+id/routeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtRouteCityName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                tools:text="Roma" />

            <TextView
                android:id="@+id/btnCloseRoute"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="#33FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dayTabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ── SUS: INDICAȚII ORIENTARE / DIRECȚIE ── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/panelNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/routeHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="14dp"
            app:drawableStartCompat="@android:drawable/ic_menu_compass"
            android:drawablePadding="10dp"
            android:text="În 200 m faceți la stânga"
            android:textColor="#011C40"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            app:drawableTint="#2196F3" />
    </androidx.cardview.widget.CardView>

    <!-- ── MAP CONTAINER ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/routeHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomLayoutInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- POPUP PIN COMPACT CU IMAGINE ȘI ADD/DELETE -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPinPopup"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="8dp">
                        <ImageView
                            android:id="@+id/imgPinPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/rome" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtPinType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#E67E22"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            tools:text="MUSEUM" />

                        <TextView
                            android:id="@+id/txtPinName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/navy_blue_1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="Colosseum" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPinAddDelete"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="6dp"
                    android:text="ADD"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/blue"
                    app:cornerRadius="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- POPUP ORAȘ SELECTAT -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMapPopup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/imgPopupFrame"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageView
                        android:id="@+id/imgPopupCity"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/rome" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/txtPopupLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="ITALY"
                    android:textColor="#E67E22"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/imgPopupFrame"
                    app:layout_constraintTop_toTopOf="@id/imgPopupFrame"
                    app:layout_constraintEnd_toStartOf="@id/btnPopupDetails" />

                <TextView
                    android:id="@+id/txtPopupCityName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Rome"
                    android:textColor="@color/navy_blue_1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/txtPopupLabel"
                    app:layout_constraintTop_toBottomOf="@id/txtPopupLabel"
                    app:layout_constraintEnd_toStartOf="@id/btnPopupDetails" />

                <TextView
                    android:id="@+id/txtPopupDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="@id/txtPopupCityName"
                    app:layout_constraintTop_toBottomOf="@id/txtPopupCityName"
                    app:layout_constraintEnd_toStartOf="@id/btnPopupDetails" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPopupDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Details"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/navy_blue_1"
                    app:cornerRadius="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- CONTROALE ZOOM SI ME -->
        <LinearLayout
            android:id="@+id/zoomControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.45">

            <androidx.cardview.widget.CardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="4dp">
                <Button
                    android:id="@+id/btnMyLocation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="ME"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#26658C"
                    android:background="@android:color/transparent"
                    android:padding="0dp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="4dp">
                <Button
                    android:id="@+id/btnZoomIn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="+"
                    android:textSize="20sp"
                    android:textColor="#333333"
                    android:background="@android:color/transparent"
                    android:padding="0dp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="4dp">
                <Button
                    android:id="@+id/btnZoomOut"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="-"
                    android:textSize="20sp"
                    android:textColor="#333333"
                    android:background="@android:color/transparent"
                    android:padding="0dp" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── PANOUL DE JOS ── -->
    <LinearLayout
        android:id="@+id/bottomLayoutInside"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/scrollCardsHolder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CHIPS CATEGORII -->
        <LinearLayout
            android:id="@+id/filterChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="6"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="8dp">
            <TextView android:id="@+id/chipMuseum" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#819CB8" android:gravity="center" android:text="Museums" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            <TextView android:id="@+id/chipRestaurant" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#D3B6D3" android:gravity="center" android:text="Restaurants" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            <TextView android:id="@+id/chipNature" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#8FB880" android:gravity="center" android:text="Nature" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            <TextView android:id="@+id/chipCafe" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#C4B28E" android:gravity="center" android:text="Cafes" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            <TextView android:id="@+id/chipHistorical" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#52A5CE" android:gravity="center" android:text="Historical" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
            <TextView android:id="@+id/chipMonument" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#F4BEAE" android:gravity="center" android:text="Monuments" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" />
        </LinearLayout>

        <!-- CHIPS REGIUNI EUROPA -->
        <HorizontalScrollView
            android:id="@+id/scrollRegionChips"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:paddingHorizontal="8dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView android:id="@+id/chipAllEurope" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="@color/blue" android:gravity="center" android:paddingHorizontal="14dp" android:text="All Europe" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/chipWesternEurope" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="14dp" android:text="Western Europe" android:textColor="#011C40" android:textSize="11sp" />
                <TextView android:id="@+id/chipCentralEurope" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="14dp" android:text="Central Europe" android:textColor="#011C40" android:textSize="11sp" />
                <TextView android:id="@+id/chipSouthernEurope" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="14dp" android:text="Southern Europe" android:textColor="#011C40" android:textSize="11sp" />
                <TextView android:id="@+id/chipNorthernEurope" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="14dp" android:text="Northern Europe" android:textColor="#011C40" android:textSize="11sp" />
                <TextView android:id="@+id/chipEasternEurope" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="14dp" android:text="Eastern Europe" android:textColor="#011C40" android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- CHIPS TRAVEL MODE -->
        <LinearLayout
            android:id="@+id/travelModeContainer"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chipByCar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="@color/blue"
                android:gravity="center"
                android:text="🚗 By Car"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipWalking"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="🚶 Walking"
                android:textColor="#011C40"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD SUMAR MARE, CATCHY, LIZIBIL JOS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutSummaryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="#F0F4F8"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNextDestination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#023859"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        tools:text="📍 Next: Colosseum (1.2 km · 15 min)" />

                    <TextView
                        android:id="@+id/txtTotalRouteSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#26658C"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="⏱ Total: 1h 15m · 12.4 km" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartTrip"
                    android:layout_width="92dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:text="START"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#26658C"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- SCROLL CARDURI ORAȘE (LIPIT FIX DEASUPRA BARII DE NAVIGARE, ASCUNS ÎN MODUL TRASEU) -->
    <HorizontalScrollView
        android:id="@+id/scrollCardsHolder"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutCardsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- BARA NAVIGARE JOS -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_discover" app:tint="#AAAAAA" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Discover" android:textColor="#AAAAAA" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_map" app:tint="@color/light_turq_1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Map" android:textColor="@color/light_turq_1" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnWishlist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_heart" app:tint="#AAAAAA" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Journeys" android:textColor="#AAAAAA" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAI"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ai" app:tint="#AAAAAA" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assistant" android:textColor="#AAAAAA" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>