<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/exploreMapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".ExploreActivity"
    tools:ignore="SpellCheckingInspection">

    <!-- ── HEADER NOU: oraș + selector zile + buton X (înlocuiește panelNavigation vechi de sus) ── -->
    <LinearLayout
        android:id="@+id/routeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtRouteCityName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Roma" />

            <TextView
                android:id="@+id/btnCloseRoute"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="#33FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dayTabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ── Panou instrucțiuni navigare, vizibil doar după Start, sub header ── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/panelNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/routeHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="14dp"
            app:drawableStartCompat="@android:drawable/ic_menu_compass"
            android:drawablePadding="12dp"
            android:text="@string/calculating_route"
            android:textColor="#011C40"
            android:textSize="13sp"
            android:textStyle="bold"
            app:drawableTint="#2196F3" />
    </androidx.cardview.widget.CardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#E1F5FE"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomLayoutInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ── Card pop-up pin: nume, tip, poză, add/delete traseu, auto-close 3s ── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPinPopup"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.35">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/imgPinFrame"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/imgPinPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/rome" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/txtPinType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#E67E22"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    tools:text="MUSEUM"
                    app:layout_constraintStart_toEndOf="@id/imgPinFrame"
                    app:layout_constraintTop_toTopOf="@id/imgPinFrame"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtPinName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/navy_blue_1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Colosseum"
                    app:layout_constraintStart_toStartOf="@id/txtPinType"
                    app:layout_constraintTop_toBottomOf="@id/txtPinType"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPinRouteAction"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="6dp"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/blue"
                    app:cornerRadius="8dp"
                    tools:text="Add"
                    app:layout_constraintStart_toStartOf="@id/txtPinName"
                    app:layout_constraintTop_toBottomOf="@id/txtPinName" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/zoomControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.45"
            tools:ignore="RtlHardcoded">

            <androidx.cardview.widget.CardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="4dp">
                <Button
                    android:id="@+id/btnMyLocation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="ME"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#26658C"
                    android:background="@android:color/transparent"
                    android:padding="0dp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="4dp">
                <Button
                    android:id="@+id/btnZoomIn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/btn_plus"
                    android:textSize="20sp"
                    android:textColor="#333333"
                    android:background="@android:color/transparent"
                    android:padding="0dp" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="21dp"
                app:cardElevation="4dp">
                <Button
                    android:id="@+id/btnZoomOut"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/btn_minus"
                    android:textSize="20sp"
                    android:textColor="#333333"
                    android:background="@android:color/transparent"
                    android:padding="0dp" />
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartTrip"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="@string/btn_start"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#26658C"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:elevation="5dp"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardMapPopup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/imgPopupFrame"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <ImageView
                        android:id="@+id/imgPopupCity"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/rome"
                        android:contentDescription="@string/city_rome" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/txtPopupLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/label_italy"
                    android:textColor="#E67E22"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:layout_constraintStart_toEndOf="@id/imgPopupFrame"
                    app:layout_constraintTop_toTopOf="@id/imgPopupFrame"
                    app:layout_constraintEnd_toStartOf="@id/btnPopupDetails" />

                <TextView
                    android:id="@+id/txtPopupCityName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/city_rome"
                    android:textColor="@color/navy_blue_1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/txtPopupLabel"
                    app:layout_constraintTop_toBottomOf="@id/txtPopupLabel"
                    app:layout_constraintEnd_toStartOf="@id/btnPopupDetails" />

                <TextView
                    android:id="@+id/txtPopupDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="@id/txtPopupCityName"
                    app:layout_constraintTop_toBottomOf="@id/txtPopupCityName"
                    app:layout_constraintEnd_toStartOf="@id/btnPopupDetails" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPopupDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="@string/btn_details"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/navy_blue_1"
                    app:cornerRadius="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Panou jos: chips categorii + transport + distanță/timp total + până la următoarea atracție ── -->
    <LinearLayout
        android:id="@+id/bottomLayoutInside"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/mapContainer"
        app:layout_constraintBottom_toTopOf="@id/scrollCardsHolder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/filterChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="6"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="10dp">
            <TextView android:id="@+id/chipMuseum" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#819CB8" android:gravity="center" android:paddingHorizontal="1dp" android:text="@string/filter_museums" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/chipRestaurant" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#D3B6D3" android:gravity="center" android:paddingHorizontal="1dp" android:text="@string/filter_restaurants" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/chipNature" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#8FB880" android:gravity="center" android:paddingHorizontal="1dp" android:text="@string/filter_nature" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/chipCafe" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#C4B28E" android:gravity="center" android:paddingHorizontal="1dp" android:text="@string/filter_cafes" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/chipHistorical" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#52A5CE" android:gravity="center" android:paddingHorizontal="1dp" android:text="@string/filter_historical" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/chipMonument" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:layout_marginHorizontal="1dp" android:background="@drawable/bg_chip_selected" android:backgroundTint="#F4BEAE" android:gravity="center" android:paddingHorizontal="1dp" android:text="Monuments" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btnTransportCar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="@color/blue"
                android:gravity="center"
                android:text="🚗 Car"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:tag="car" />

            <TextView
                android:id="@+id/btnTransportWalk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="#F5F5F5"
                android:gravity="center"
                android:text="🚶 Walk"
                android:textColor="#011C40"
                android:textSize="12sp"
                android:tag="walk" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/txtTotalRouteSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#011C40"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="42.3 km · 1h 05m total"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/txtNextStopInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#26658C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Next: 1.2 km · 15 min"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scrollCardsHolder"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/bottomLayoutInside"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutCardsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_discover"
                app:tint="#AAAAAA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_discover"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_map"
                app:tint="@color/light_turq_1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_map"
                android:textColor="@color/light_turq_1"
                android:textStyle="bold"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnWishlist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_heart"
                app:tint="#AAAAAA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_wishlist"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAI"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_ai"
                app:tint="#AAAAAA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_ai"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
