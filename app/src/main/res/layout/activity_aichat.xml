<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aiChatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_forward"
            android:rotation="180"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/imgAiChatIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_square_icon"
            android:padding="7dp"
            android:src="@drawable/ic_ai"
            app:tint="@color/navy_blue_1"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-black"
            android:text="Voiaj AI"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imgAiChatIcon"
            app:layout_constraintTop_toTopOf="@id/imgAiChatIcon"
            app:layout_constraintBottom_toTopOf="@id/rowTypingStatus"
            app:layout_constraintVertical_chainStyle="packed" />

        <LinearLayout
            android:id="@+id/rowTypingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="@id/imgAiChatIcon"
            app:layout_constraintTop_toBottomOf="@id/imgAiChatIcon"
            app:layout_constraintBottom_toBottomOf="@id/imgAiChatIcon">

            <View
                android:id="@+id/dotTyping"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_status_active" />

            <TextView
                android:id="@+id/txtTypingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Typing..."
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnNewChat"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_status_pill"
            android:padding="7dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ZONA REPARATĂ: Containerul de scroll pentru mesaje conectat direct la inputBar -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

    <!-- Bara de input -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/edtChatInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="@color/bg"
            android:hint="Customize the itinerary..."
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/navy_blue_1"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnSendChat"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="@color/beige"
            android:padding="13dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/navy_blue_1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>