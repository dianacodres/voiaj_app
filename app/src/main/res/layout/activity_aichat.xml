<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aiChatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_forward"
            android:rotation="180"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/imgAiChatIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_square_icon"
            android:padding="7dp"
            android:src="@drawable/ic_ai"
            app:tint="@color/navy_blue_1"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-black"
            android:text="Voiaj AI"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imgAiChatIcon"
            app:layout_constraintTop_toTopOf="@id/imgAiChatIcon"
            app:layout_constraintBottom_toTopOf="@id/rowTypingStatus"
            app:layout_constraintVertical_chainStyle="packed" />

        <LinearLayout
            android:id="@+id/rowTypingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="@id/imgAiChatIcon"
            app:layout_constraintTop_toBottomOf="@id/imgAiChatIcon"
            app:layout_constraintBottom_toBottomOf="@id/imgAiChatIcon">

            <View
                android:id="@+id/dotTyping"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_status_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Typing..."
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_status_pill"
            android:padding="7dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Mesaj initial AI (text simplu) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="@color/white"
                android:padding="12dp"
                android:text="Hi! I'm Voiaj AI. Where are we headed?"
                android:textColor="@color/navy_blue_1"
                android:textSize="14sp" />

            <!-- Mesajul userului -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_square_button_dark"
                android:padding="12dp"
                android:text="Plan 4 days in Rome in May"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- Cardul de itinerariu generat -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardItinerary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/light_turq_1"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/txtItineraryTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="IT Rome — 4 days"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/btnSaveItinerary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Art, history &amp; food"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="@id/txtItineraryTitle"
                            app:layout_constraintTop_toBottomOf="@id/txtItineraryTitle"
                            app:layout_constraintEnd_toStartOf="@id/btnSaveItinerary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveItinerary"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Save"
                            android:textAllCaps="false"
                            android:textColor="@color/navy_blue_1"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="@color/beige"
                            app:cornerRadius="10dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="@color/navy_blue_1" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif-black" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAYS" android:textColor="#999999" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#EEEEEE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:id="@+id/txtItineraryBudget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="€620" android:textColor="@color/navy_blue_1" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif-black" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BUDGET" android:textColor="#999999" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#EEEEEE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11" android:textColor="@color/navy_blue_1" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif-black" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SPOTS" android:textColor="#999999" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_avatar"
                            android:backgroundTint="@color/light_turq_1"
                            android:gravity="center"
                            android:text="D1"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ancient Rome" android:textColor="@color/navy_blue_1" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Colosseum, Forum, Pantheon" android:textColor="#999999" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginStart="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_avatar"
                            android:backgroundTint="@color/light_turq_1"
                            android:gravity="center"
                            android:text="D2"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vatican City" android:textColor="@color/navy_blue_1" android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Museums, St. Peter's, Sistine" android:textColor="#999999" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card mic de vreme -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWeatherReply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="May is perfect — mild &amp; sunny:"
                        android:textColor="@color/navy_blue_1"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="14dp"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀" android:textSize="16sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="18°" android:textColor="@color/navy_blue_1" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="14dp"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧" android:textSize="16sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Low" android:textColor="@color/navy_blue_1" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💶" android:textSize="16sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="€155/d" android:textColor="@color/navy_blue_1" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Chip-uri de raspuns rapid -->
    <LinearLayout
        android:id="@+id/layoutQuickReplies"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/chipAddDay"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/white"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="+ Add a day"
            android:textColor="@color/navy_blue_1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipCheaper"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/white"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Cheaper"
            android:textColor="@color/navy_blue_1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipBestFood"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/white"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Best food"
            android:textColor="@color/navy_blue_1"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bara de input -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/edtChatInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="@color/bg"
            android:hint="Customize the itinerary..."
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/navy_blue_1"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnSendChat"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="@color/beige"
            android:padding="13dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/navy_blue_1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>