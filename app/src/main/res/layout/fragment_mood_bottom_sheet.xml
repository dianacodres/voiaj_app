<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_top_rounded"
    android:padding="20dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="@color/cream_2" />

    <!-- Titlu mood -->
    <TextView
        android:id="@+id/txtMoodTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="History and Culture"
        android:textColor="@color/navy_blue_1"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="4dp" />

    <!-- Subtitlu -->
    <TextView
        android:id="@+id/txtMoodSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6 destinations available"
        android:textColor="#999999"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- Lista orase -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

</LinearLayout>