<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/imgPoiFrame"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/imgPoi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/txtPoiName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textColor="@color/navy_blue_1"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imgPoiFrame"
        app:layout_constraintTop_toTopOf="@id/imgPoiFrame"
        app:layout_constraintEnd_toStartOf="@id/circleSelect" />

    <TextView
        android:id="@+id/txtPoiSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/txtPoiName"
        app:layout_constraintTop_toBottomOf="@id/txtPoiName"
        app:layout_constraintEnd_toStartOf="@id/circleSelect" />

    <FrameLayout
        android:id="@+id/circleSelect"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_selection_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgPoiFrame"
        app:layout_constraintBottom_toBottomOf="@id/imgPoiFrame">

        <ImageView
            android:id="@+id/imgCheck"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>