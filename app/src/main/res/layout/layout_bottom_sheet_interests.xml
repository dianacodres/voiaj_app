<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_top_rounded"
    android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#DDDDDD"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modify Your Interests"
        android:textColor="@color/navy_blue_1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="22dp"
        android:baselineAligned="false">
        <include android:id="@+id/cardBeaches" layout="@layout/view_interest_card" android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:layout_marginEnd="8dp" />
        <include android:id="@+id/cardFood" layout="@layout/view_interest_card" android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:baselineAligned="false">
        <include android:id="@+id/cardCities" layout="@layout/view_interest_card" android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:layout_marginEnd="8dp" />
        <include android:id="@+id/cardNature" layout="@layout/view_interest_card" android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:baselineAligned="false">
        <include android:id="@+id/cardCulture" layout="@layout/view_interest_card" android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:layout_marginEnd="8dp" />
        <include android:id="@+id/cardMountains" layout="@layout/view_interest_card" android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:layout_marginStart="8dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveInterests"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="24dp"
        android:text="Apply New Interests"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/blue"
        app:cornerRadius="14dp" />
</LinearLayout>